# ─────────────────────────────────────────────────────────────────────────────
# Copiar este archivo como .env.local y completar con los valores del proyecto.
# .env.local NUNCA se sube a GitHub (está en .gitignore).
# En Vercel: Project → Settings → Environment Variables (las mismas variables).
# ─────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ SECRETA: salta todas las políticas RLS. Sólo servidor, jamás en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (clave pública VAPID). Generar con: npx web-push generate-vapid-keys
# La clave PRIVADA va como secreto de la Edge Function send-push, no aquí.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Contraseña temporal para usuarios creados desde /admin o scripts/cargar-usuarios.mjs
DEFAULT_STUDENT_PASSWORD=

# Correo del perfil que recibe la alerta de devoluciones incompletas (director/a de carrera)
DIRECTOR_CARRERA_EMAIL=
